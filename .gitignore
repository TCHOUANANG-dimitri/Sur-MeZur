# Full SAM checkpoint (~375MB) — not used in production, MobileSAM is.
# GitHub hard-rejects files over 100MB; keep it local-only.
backend/ml/weights/sam_vit_b_01ec64.pth

# Segmentation multiclasse MediaPipe (16MB) : testée contre MobileSAM sur les
# 13 sujets, elle donne 4,9 cm d'erreur de largeur contre 4,3 — piste écartée.
# Le fichier reste en local pour qui voudrait refaire la mesure.
backend/ml/weights/selfie_multiclass_256x256.tflite

# Common junk that shouldn't be tracked.
__pycache__/
*.pyc
.venv/
venv/
node_modules/
*.db
# Journaux SQLite (mode WAL) crees a cote de la base.
*.db-wal
*.db-shm
.expo/
dist/
build/

# Rapport genere depuis RAPPORT_PROJET.md
RAPPORT_PROJET.docx

# Campagne de collecte synchronisee en local (ml/scripts/telecharger_collecte.py) :
# photos de volontaires, jamais versionnees.
ml/data/collecte/

# Sur-MeZur Android (Agent B) : cles de signature et sorties de build, jamais
# dans le depot public (ni cles, ni mots de passe).
*.keystore
*.jks
android-twa/app/build/

# Stockages runtime du backend : jamais versionnes, ignorent les photos.
backend/uploads/
backend/protected_store/
backend/avatar_store/
backend/dataset_store/
