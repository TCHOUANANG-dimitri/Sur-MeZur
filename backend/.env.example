# Copy to .env and adjust. Sensible defaults are baked in so the app runs with none of this set.

# SQLite by default (zero setup). Point at Postgres in production, e.g.:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/sur_mezur
DATABASE_URL=sqlite:///./sur_mezur.db

JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

CORS_ORIGINS=http://localhost:5173

UPLOAD_DIR=./uploads

# --- 3D avatar (Blender + MPFB2) --------------------------------------------
# Local development only: Blender runs as a subprocess and needs the binary
# on disk. It does NOT run on shared/mutualized hosting (e.g. O2Switch) —
# no root access, no way to install a several-hundred-MB GUI-toolkit binary,
# and no budget for a multi-second subprocess per request. Leave unset there;
# /avatars/capabilities reports avatar_enabled=false and the API falls back
# to the mock reference automatically (see app/services/mock_ai.py).
#
# Setup (local machine only):
#   1. Install Blender 4.5+ (https://www.blender.org/download/), any location.
#   2. Install the MPFB2 add-on inside that Blender (Edit > Preferences >
#      Get Extensions > search "MPFB2"), or via the Blender Extensions
#      Platform. Required — the generator calls bpy.ops.mpfb.*.
#   3. Point BLENDER_PATH at the executable:
#      Windows : C:\Program Files\Blender Foundation\Blender 4.5\blender.exe
#      macOS   : /Applications/Blender.app/Contents/MacOS/Blender
#      Linux   : /usr/bin/blender  (or wherever your package manager put it)
# BLENDER_PATH=

# Where generated GLBs are written. Deliberately OUTSIDE upload_dir: that
# directory is mounted as public static files (see main.py), and an avatar
# must only be reachable through GET /avatars/{id}/glb, which checks
# ownership. Change this only if you also keep it outside upload_dir.
AVATAR_OUTPUT_DIR=./avatar_store

# Seconds allowed per generation before it's treated as failed (falls back
# to the mock). A real run takes 5-15s on CPU; 120s leaves headroom for a
# cold machine without hanging a request indefinitely.
AVATAR_BLENDER_TIMEOUT=120
