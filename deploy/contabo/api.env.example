# /etc/surmezur/api.env  — configuration de l'API en production.
# Droits : root:surmezur, 640 (contient le secret JWT).
#
# Lu par systemd (EnvironmentFile) : une ligne NOM=valeur, sans guillemets,
# sans espaces autour du « = ».

# Base SQLite : 4 barres obliques = chemin absolu.
DATABASE_URL=sqlite:////srv/surmezur/data/sur_mezur.db

# Reprendre EXACTEMENT la valeur du .env O2Switch : les sessions en cours
# restent valides et personne n'a a se reconnecter apres la bascule.
# Nouvelle installation seulement : python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=A_REMPLACER

ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Donnees : hors du depot git.
UPLOAD_DIR=/srv/surmezur/data/uploads
DATASET_DIR=/srv/surmezur/data/dataset_store
AVATAR_OUTPUT_DIR=/srv/surmezur/data/avatar_store

# Le web et la collecte passent par le proxy Vercel (pas de CORS) ; le mobile
# n'est pas soumis au CORS. Seul le developpement local en a besoin.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:3001

# Chaine de mesure. uvicorn est un vrai serveur ASGI : l'analyse part
# directement apres l'envoi des photos, sans le worker cron d'O2Switch.
VISION_ENABLED=true
MEASUREMENT_WORKER_MODE=inline
# Threads par processus : (nombre de vCPU) / (nombre de workers uvicorn).
VISION_MAX_THREADS=2
