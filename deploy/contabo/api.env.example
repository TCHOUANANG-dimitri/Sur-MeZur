# /etc/surmezur/api.env  — configuration de l'API en production.
# Droits : root:surmezur, 640 (contient le mot de passe de la base et le secret JWT).
#
# Lu par systemd (EnvironmentFile) et par les scripts de deploy/contabo :
# une ligne NOM=valeur, SANS guillemets, SANS espaces autour du « = ».

# --- Base de donnees : PostgreSQL chez Supabase -----------------------------
# Chaine du POOLER EN MODE SESSION (Supabase > bouton « Connect » > « Session
# pooler »), a laquelle on ajoute « ?sslmode=require ». Forme :
#   postgresql://postgres.REF_PROJET:MOT_DE_PASSE@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
#
# - pooler session (port 5432) plutot que connexion directe : la connexion
#   directe (db.REF.supabase.co) n'est joignable qu'en IPv6 sur les offres de
#   base ; le pooler l'est en IPv4.
# - mode SESSION plutot que transaction (port 6543) : l'API garde ses propres
#   connexions ouvertes (pool SQLAlchemy) et utilise des requetes preparees,
#   que le mode transaction ne supporte pas.
# - un caractere special du mot de passe doit etre ENCODE dans l'URL :
#   # -> %23   @ -> %40   : -> %3A   / -> %2F   ? -> %3F   % -> %25
#   (le plus simple : choisir un mot de passe fait uniquement de lettres et de
#   chiffres, assez long — Supabase en genere un sur demande).
DATABASE_URL=postgresql://postgres.REF_PROJET:MOT_DE_PASSE@aws-0-eu-central-1.pooler.supabase.com:5432/postgres?sslmode=require

# Connexions par processus uvicorn (2 processus -> au plus 2 x (5 + 5) = 20).
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# --- Securite des sessions ---------------------------------------------------
# Une valeur longue et aleatoire, a generer UNE fois :
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# La changer deconnecte tout le monde (les jetons existants deviennent invalides).
JWT_SECRET=A_REMPLACER
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Mots de passe et codes --------------------------------------------------
# Production : false (jamais de code renvoye, reinitialisation fermee -> 503).
# Developpement local : true pour tester le parcours OTP.
OTP_DEV_CODE=false
# Secret HMAC-SHA256 du webhook de paiement. Vide tant que les paiements sont
# desactives : le webhook repond alors 404 meme si on l'appelle.
PAYMENT_WEBHOOK_SECRET=

# --- Fichiers : sur le disque du VPS, hors du depot git ---------------------
UPLOAD_DIR=/srv/surmezur/data/uploads
DATASET_DIR=/srv/surmezur/data/dataset_store
AVATAR_OUTPUT_DIR=/srv/surmezur/data/avatar_store

# Le web et la collecte passent par le proxy Vercel (pas de CORS) ; le mobile
# n'est pas soumis au CORS. Seul le developpement local en a besoin.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:3001

# --- Chaine de mesure --------------------------------------------------------
# uvicorn est un vrai serveur ASGI : l'analyse part directement apres l'envoi
# des photos, sans le worker cron d'O2Switch.
VISION_ENABLED=true
MEASUREMENT_WORKER_MODE=inline
# Threads de calcul par processus : (nombre de vCPU) / (nombre de workers uvicorn).
VISION_MAX_THREADS=2
