# /etc/systemd/system/surmezur-vl.service
#
# Modele de vision Qwen3-VL 4B (llama.cpp, `llama-server`) : analyse de la
# photo d'un modele pour preremplir la fiche de style des patrons.
# Installation et usage : deploy/contabo/VISION_PATRONS.md.
#
# Reglages repris des essais d'octobre 2026 (4B Q4_K_M, schema_v2) :
# image reduite a 768 jetons, contexte 4096, 3 coeurs sur 4 (le 4e reste a
# l'API). Le modele reste charge : il n'est lu sur le disque qu'au demarrage.

[Unit]
Description=Sur-MeZur vision (Qwen3-VL 4B, llama-server)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=smzadmin
Group=smzadmin
WorkingDirectory=/home/smzadmin/modeles

# N'ecoute que sur la boucle locale : seule l'API (127.0.0.1:8000) l'appelle.
# --parallel 1 : une analyse a la fois, les suivantes attendent leur tour.
ExecStart=/home/smzadmin/llama.cpp/build/bin/llama-server \
    -m /home/smzadmin/modeles/Qwen3VL-4B-Instruct-Q4_K_M.gguf \
    --mmproj /home/smzadmin/modeles/mmproj-Qwen3VL-4B-Instruct-Q8_0.gguf \
    --host 127.0.0.1 --port 8090 \
    -c 4096 -t 3 --parallel 1 --image-max-tokens 768 \
    --no-webui

# Memoire : 5,3 a 5,6 Go mesures aux essais. Plafond a 5,8 Go, et en cas de
# manque de memoire sur le VPS, c'est ce service qui est arrete en premier,
# jamais l'API ; il redemarre seul.
MemoryMax=5800M
OOMScoreAdjust=500
# Priorite basse : l'API et la mesure par photo passent devant.
Nice=10
Restart=always
RestartSec=10
# Lecture des 3 Go du modele au demarrage.
TimeoutStartSec=300

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
