{
  "expo": {
    "name": "Sur-MeZur",
    "slug": "sur-mezur",
    "owner": "dim39",
    "scheme": "surmezur",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo-icon.jpeg",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#EDEAF4"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.surmezur.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#EDEAF4",
        "foregroundImage": "./assets/logo-icon.jpeg"
      },
      "package": "com.surmezur.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-asset"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "964b5e19-4335-42ca-a5e3-ffa922508492"
      }
    }
  }
}
